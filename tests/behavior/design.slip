module pipeline #(param WIDTH=8)(clk,rst_n,din,dout) {
    logic clk; logic rst_n;
    logic [WIDTH-1:0] din; logic [WIDTH-1:0] dout;
    logic [WIDTH-1:0] stage [0:2];
    seq(clk,neg:rst_n) {
        if (!rst_n) {
            `for (`i=0; `i<3; `i=`i+1) { stage[`i]=0; }
        } else {
            stage[0]=din;
            `for (`i=1; `i<3; `i=`i+1) { stage[`i]=stage[`i-1]; }
        }
    }
    assign dout=stage[2];
}
module wrapper(clk,rst_n,din,dout) {
    pipeline #(.WIDTH(16)) u { .clk, .rst_n, .din, .dout };
}
module top(clk,rst_n,din,dout) {
    wrapper u { .clk, .rst_n, .din, .dout };
}
module arithmetic(y,narrow,wide) {
    logic [7:0] y; logic [7:0] narrow; logic [15:0] wide;
    `for (`i=0; `i<1; `i=`i+1) {
        assign y=2 && 3;
        assign narrow=(8'hff + 8'h01) >> 1;
        assign wide=(8'hff + 8'h01) >> 1;
    }
}
