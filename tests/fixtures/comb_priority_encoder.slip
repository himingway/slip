module priority_encoder (req, valid, idx) {
    logic [3:0] req;
    logic valid;
    logic [1:0] idx;

    comb {
        if (req[0]) {
            idx = 0;
            valid = 1;
        } else {
            if (req[1]) {
                idx = 1;
                valid = 1;
            } else {
                if (req[2]) {
                    idx = 2;
                    valid = 1;
                } else {
                    if (req[3]) {
                        idx = 3;
                        valid = 1;
                    } else {
                        idx = 0;
                        valid = 0;
                    }
                }
            }
        }
    }
}
