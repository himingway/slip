module uart_tx #(param CLK_FREQ = 50000000, param BAUD = 115200) (clk, rst_n, tx_data, tx_valid, tx_ready, tx_pin) {
    logic [7:0] tx_data;
    logic tx_valid;
    logic tx_ready;
    logic tx_pin;
    logic [3:0] state;
    logic [3:0] bit_cnt;
    logic [15:0] timer;
    logic tx_done;
    logic [8:0] shift_reg;

    assign tx_ready = ~(tx_valid & ~tx_done);

    seq (clk, neg: rst_n) {
        if (!rst_n) {
            tx_pin = 1;
            state = 0;
            bit_cnt = 0;
            timer = 0;
            tx_done = 0;
            shift_reg = 0;
        } else {
            if (state == 0) {
                tx_done = 0;
                if (tx_valid) {
                    shift_reg = {tx_data, 1'b0};
                    bit_cnt = 0;
                    timer = 0;
                    state = 1;
                }
            } else {
                if (state == 1) {
                    tx_pin = 0;
                    if (timer == 16'h00FF) {
                        timer = 0;
                        state = 2;
                    } else {
                        timer = timer + 1;
                    }
                } else {
                    if (state == 2) {
                        tx_pin = shift_reg[0];
                        if (timer == 16'h00FF) {
                            timer = 0;
                            shift_reg = shift_reg >> 1;
                            if (bit_cnt == 7) {
                                state = 3;
                            } else {
                                bit_cnt = bit_cnt + 1;
                            }
                        } else {
                            timer = timer + 1;
                        }
                    } else {
                        tx_pin = 1;
                        if (timer == 16'h00FF) {
                            timer = 0;
                            tx_done = 1;
                            state = 0;
                        } else {
                            timer = timer + 1;
                        }
                    }
                }
            }
        }
    }
}
