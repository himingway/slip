// Pipeline chain: N stages of registers with parametric width
// Uses `for to generate register stages and `if for optional reset
module pipeline_chain #(param STAGES = 3, param WIDTH = 8) (clk, rst_n, din, dout) {
    logic clk;
    logic rst_n;
    logic [WIDTH-1:0] din;
    logic [WIDTH-1:0] dout;
    logic [WIDTH-1:0] stage_0;
    logic [WIDTH-1:0] stage_1;
    logic [WIDTH-1:0] stage_2;

    seq (clk, neg: rst_n) {
        `for (`i = 0; `i < 3; `i = `i + 1) {
            if (!rst_n) { stage_0 = 0; } else { stage_0 = din; }
        }
    }

    assign dout = stage_2;
}
