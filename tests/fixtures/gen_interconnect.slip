// N-to-1 crossbar: N masters, 1 slave port
// Uses `for to generate per-master arbitration logic
// and `if to select the winning master
module crossbar #(param N = 4, param AW = 32, param DW = 32) (
    clk, rst_n,
    m0_req, m0_addr, m0_wdata,
    m1_req, m1_addr, m1_wdata,
    m2_req, m2_addr, m2_wdata,
    m3_req, m3_addr, m3_wdata,
    s_valid, s_addr, s_wdata
) {
    logic clk;
    logic rst_n;
    logic [N-1:0] req_vec;
    logic [AW-1:0] addr_0;
    logic [AW-1:0] addr_1;
    logic [AW-1:0] addr_2;
    logic [AW-1:0] addr_3;
    logic [DW-1:0] wdata_0;
    logic [DW-1:0] wdata_1;
    logic [DW-1:0] wdata_2;
    logic [DW-1:0] wdata_3;
    logic s_valid;
    logic [AW-1:0] s_addr;
    logic [DW-1:0] s_wdata;
    logic [1:0] grant;

    assign req_vec = {m3_req, m2_req, m1_req, m0_req};

    // Fixed-priority arbiter
    comb {
        if (m0_req) { grant = 0; }
        else if (m1_req) { grant = 1; }
        else if (m2_req) { grant = 2; }
        else if (m3_req) { grant = 3; }
        else { grant = 0; }
    }

    // Mux selected master to slave
    comb {
        if (grant == 0) { s_addr = addr_0; s_wdata = wdata_0; s_valid = m0_req; }
        else if (grant == 1) { s_addr = addr_1; s_wdata = wdata_1; s_valid = m1_req; }
        else if (grant == 2) { s_addr = addr_2; s_wdata = wdata_2; s_valid = m2_req; }
        else { s_addr = addr_3; s_wdata = wdata_3; s_valid = m3_req; }
    }
}
