// Top-level: uses external prim_fifo via regex port mapping
// The prim_fifo.sv lives in the ip/ directory, discovered via -ip flag
module fifo_user #(param DEPTH = 4, param WIDTH = 8) (clk, rst_n, din, dout, full, empty) {
    logic clk;
    logic rst_n;
    logic [WIDTH-1:0] din;
    logic [WIDTH-1:0] dout;
    logic full;
    logic empty;
    logic wr_en;
    logic [WIDTH-1:0] fifo_wdata;

    assign wr_en = !full;
    assign fifo_wdata = din;

    prim_fifo #(.Depth(DEPTH), .Width(WIDTH)) u_fifo {
        .clk,
        .rst_n,
        .wren(wr_en),
        "w(.+)" => "fifo_w\1",
        .rdata(dout),
        .full,
        .empty
    };
}
