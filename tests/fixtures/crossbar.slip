module arbiter #(param N = 4) (clk, rst_n, req, gnt) {
    logic [N-1:0] req;
    logic [N-1:0] gnt;

    logic [N-1:0] masked_req;
    logic [N-1:0] prio;

    assign prio = {prio[N-2:0], prio[N-1]};

    assign masked_req = req & ~prio;

    seq (clk, neg: rst_n) {
        if (!rst_n) {
            gnt = 0;
            prio = 1;
        } else {
            if (|masked_req) {
                gnt = masked_req & ~(masked_req - 1);
            } else {
                if (|req) {
                    gnt = req & ~(req - 1);
                } else {
                    gnt = 0;
                }
            }
        }
    }
}
