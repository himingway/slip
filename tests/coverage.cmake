cmake_minimum_required(VERSION 3.24)

function(percent hit total output)
    if(total EQUAL 0)
        set(${output} "n/a" PARENT_SCOPE)
        return()
    endif()
    math(EXPR value "${hit}*10000/${total}")
    math(EXPR whole "${value}/100")
    math(EXPR fraction "${value}%100")
    if(fraction LESS 10)
        set(fraction "0${fraction}")
    endif()
    set(${output} "${whole}.${fraction}%" PARENT_SCOPE)
endfunction()

set(report_dir "${BUILD_DIR}/coverage")
file(MAKE_DIRECTORY "${report_dir}")
set(report "# Slip source coverage\n\nOnly production `src/*.cpp` files are included; tests, headers, STL and slang are excluded. Exception-only arcs are excluded from branch totals; other compiler-generated arcs remain.\n\n| File | Lines | Line coverage | Branches | Branch coverage |\n|---|---:|---:|---:|---:|\n")
set(all_lines 0)
set(hit_lines 0)
set(all_branches 0)
set(hit_branches 0)
set(metrics "[")
foreach(source frontend.cpp functions.cpp pattern.cpp slang_backend.cpp compiler.cpp main.cpp)
    if(source STREQUAL "main.cpp")
        set(target slip)
    else()
        set(target slip_core)
    endif()
    set(object "${BUILD_DIR}/CMakeFiles/${target}.dir/src/${source}.gcno")
    if(NOT EXISTS "${object}")
        message(FATAL_ERROR "Coverage object missing: ${object}; build the coverage preset first")
    endif()
    execute_process(COMMAND "${GCOV}" -j -b -c -o "${object}" "${SOURCE_DIR}/src/${source}"
        WORKING_DIRECTORY "${report_dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "gcov failed: ${output}${errors}")
    endif()
    get_filename_component(stem "${source}" NAME_WE)
    execute_process(COMMAND "${GZIP}" -dc "${report_dir}/${stem}.gcov.json.gz"
        RESULT_VARIABLE result OUTPUT_VARIABLE json ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot read coverage JSON: ${errors}")
    endif()
    string(JSON file_count LENGTH "${json}" files)
    math(EXPR file_last "${file_count}-1")
    set(found FALSE)
    foreach(index RANGE ${file_last})
        string(JSON filename GET "${json}" files ${index} file)
        if(filename STREQUAL "${SOURCE_DIR}/src/${source}")
            string(JSON data GET "${json}" files ${index})
            set(found TRUE)
            break()
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Source ${source} missing from gcov output")
    endif()
    string(JSON line_count LENGTH "${data}" lines)
    math(EXPR line_last "${line_count}-1")
    set(lines "")
    set(covered "")
    set(branch_total 0)
    set(branch_hit 0)
    foreach(index RANGE ${line_last})
        string(JSON line GET "${data}" lines ${index})
        string(JSON number GET "${line}" line_number)
        string(JSON count GET "${line}" count)
        list(APPEND lines "${number}")
        if(count GREATER 0)
            list(APPEND covered "${number}")
        endif()
        string(JSON branch_count LENGTH "${line}" branches)
        if(branch_count GREATER 0)
            math(EXPR branch_last "${branch_count}-1")
            foreach(branch_index RANGE ${branch_last})
                string(JSON branch GET "${line}" branches ${branch_index})
                string(JSON is_throw GET "${branch}" throw)
                if(is_throw)
                    continue()
                endif()
                math(EXPR branch_total "${branch_total}+1")
                string(JSON count GET "${branch}" count)
                if(count GREATER 0)
                    math(EXPR branch_hit "${branch_hit}+1")
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES lines)
    list(REMOVE_DUPLICATES covered)
    list(LENGTH lines line_total)
    list(LENGTH covered line_hit)
    percent(${line_hit} ${line_total} line_percent)
    percent(${branch_hit} ${branch_total} branch_percent)
    string(APPEND report "| ${source} | ${line_hit}/${line_total} | ${line_percent} | ${branch_hit}/${branch_total} | ${branch_percent} |\n")
    string(APPEND metrics "{\"file\":\"src/${source}\",\"lines\":${line_total},\"lines_hit\":${line_hit},\"branches\":${branch_total},\"branches_hit\":${branch_hit}},")
    math(EXPR all_lines "${all_lines}+${line_total}")
    math(EXPR hit_lines "${hit_lines}+${line_hit}")
    math(EXPR all_branches "${all_branches}+${branch_total}")
    math(EXPR hit_branches "${hit_branches}+${branch_hit}")
endforeach()
percent(${hit_lines} ${all_lines} line_percent)
percent(${hit_branches} ${all_branches} branch_percent)
string(APPEND report "| **Total** | **${hit_lines}/${all_lines}** | **${line_percent}** | **${hit_branches}/${all_branches}** | **${branch_percent}** |\n")
string(REGEX REPLACE ",$" "" metrics "${metrics}")
string(APPEND metrics "]")
file(WRITE "${report_dir}/report.md" "${report}")
file(WRITE "${report_dir}/summary.json" "{\"files\":${metrics},\"lines\":${all_lines},\"lines_hit\":${hit_lines},\"branches\":${all_branches},\"branches_hit\":${hit_branches}}\n")
message(STATUS "Slip source lines: ${line_percent}; branches (excluding exception arcs): ${branch_percent}")
message(STATUS "Coverage report: ${report_dir}/report.md")
