{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release compiler",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SLIP_SANITIZERS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SLIP_COVERAGE": false,
        "SLIP_FUZZING": false,
        "SLIP_LIBFUZZER": false
      }
    },
    {
      "name": "sanitize",
      "displayName": "Compiler with ASan and UBSan",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SLIP_SANITIZERS": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SLIP_COVERAGE": false,
        "SLIP_FUZZING": false,
        "SLIP_LIBFUZZER": false
      }
    },
    {
      "name": "thread-sanitize",
      "displayName": "Compiler with ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/thread-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SLIP_SANITIZERS": false,
        "SLIP_THREAD_SANITIZER": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SLIP_COVERAGE": false,
        "SLIP_FUZZING": false,
        "SLIP_LIBFUZZER": false
      }
    },
    {
      "name": "coverage",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SLIP_SANITIZERS": false,
        "SLIP_COVERAGE": true,
        "SLIP_FUZZING": true,
        "SLIP_LIBFUZZER": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "fuzz",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SLIP_SANITIZERS": true,
        "SLIP_COVERAGE": false,
        "SLIP_FUZZING": true,
        "SLIP_LIBFUZZER": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "thread-sanitize",
      "configurePreset": "thread-sanitize"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "thread-sanitize",
      "configurePreset": "thread-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
