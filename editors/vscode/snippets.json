{
  "Slip module": { "prefix": "module", "body": ["module ${1:name} (${2:clk, rst_n}) {", "    $0", "}"] },
  "Sequential block": { "prefix": "seq", "body": ["seq (${1:clk}, neg: ${2:rst_n}) {", "    if (!${2:rst_n}) {", "        $0", "    } else {", "    }", "}"] },
  "Combinational block": { "prefix": "comb", "body": ["comb {", "    $0", "}"] },
  "Generation loop": { "prefix": "genfor", "body": ["`for (`${1:i} = 0; `${1:i} < ${2:N}; `${1:i}++) {", "    $0", "}"] },
  "Instance": { "prefix": "inst", "body": ["${1:module_type} ${2:u_name} {", "    .$0", "};"] }
}
