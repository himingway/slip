module top #(param WIDTH = 8) (clk, rst_n, enable, din, dout) {
    logic clk;
    logic rst_n;
    logic enable;
    logic [WIDTH-1:0] din;
    logic [WIDTH-1:0] dout;

    seq (clk, neg: rst_n) {
        if (!rst_n) {
            dout = '0;
        } else {
            if (enable) {
                dout = din;
            }
        }
    }
}
