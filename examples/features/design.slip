typedef struct packed {
    logic [3:0] hi;
    logic [3:0] lo;
} packet_t;
typedef enum logic [1:0] { IDLE, RUN } state_t;

function [7:0] swap_nibbles(logic [7:0] x) {
    packet_t value;
    value.hi = x[7:4];
    value.lo = x[3:0];
    return {value.lo, value.hi};
}

bundle Stream #(param W = 8) {
    output logic [W-1:0] data;
    output logic valid;
    input logic ready;
}

module pipeline #(param N = 1) (clk, rst_n, din, dout) {
    logic clk; logic rst_n;
    logic [7:0] din; logic [7:0] dout;
    logic [7:0] stages [0:N-1];
    static_assert(N > 0, "pipeline must have a stage");
    seq (neg: clk, neg: rst_n) {
        if (!rst_n) {
            `for (`i = 0; `i < N; `i = `i + 1) { stages[`i] = 0; }
        } else {
            stages[0] = din;
            `for (`i = 1; `i < N; `i = `i + 1) { stages[`i] = stages[`i-1]; }
        }
    }
    assign dout = stages[N-1];
}

module producer(din, tx) {
    logic [7:0] din;
    master Stream tx;
    assign tx.data = din;
    assign tx.valid = 1'b1;
}
module consumer(rx, dout) {
    slave Stream rx;
    logic [7:0] dout;
    assign dout = rx.data;
    assign rx.ready = 1'b1;
}
module features(clk, rst_n, din, base, hi, lo, selected, short_out, long_out, bus_out, active, packet) {
    logic clk; logic rst_n;
    logic [7:0] din;
    logic [2:0] base;
    logic [3:0] hi; logic [3:0] lo; logic [3:0] selected;
    logic [7:0] short_out; logic [7:0] long_out; logic [7:0] bus_out;
    logic active;
    packet_t packet;
    state_t state;
    logic [7:0] memory [0:1][0:1];
    bus Stream link;

    assign packet.hi = din[7:4];
    assign packet.lo = din[3:0];
    assign memory[0][1] = swap_nibbles(din);
    assign {hi, lo} = memory[0][1];
    assign selected = din[base +: 4];
    pipeline #(.N(2)) short_pipe { .clk, .rst_n, .din(memory[0][1]), .dout(short_out) };
    pipeline #(.N(3)) long_pipe { .clk, .rst_n, .din(memory[0][1]), .dout(long_out) };
    producer p { .din, .tx(link) };
    consumer c { .rx(link), .dout(bus_out) };
    seq (neg: clk, neg: rst_n) {
        if (!rst_n) { state = IDLE; }
        else { if (din[0]) { state = RUN; } else { state = IDLE; } }
    }
    seq (neg: clk) { assert(base <= 4, "slice exceeds data width"); }
    assign active = state == RUN;
}
