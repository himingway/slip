module producer #(param W = 8) (tx, data, enable) {
    interface Stream.master tx;
    logic [W-1:0] data;
    logic enable;

    seq (tx.clk, neg: tx.rst_n) {
        if (!tx.rst_n) {
            tx.data = '0;
            tx.valid = 1'b0;
        } else if (tx.ready) {
            tx.data = data;
            tx.valid = enable;
        }
    }
}

module top #(param W = 16) (clk, rst_n, data, enable, observed) {
    logic clk;
    logic rst_n;
    logic [W-1:0] data;
    logic enable;
    logic [W-1:0] observed;

    interface Stream #(.W(W)) link { .clk, .rst_n };
    producer #(.W(W)) source {
        .tx(link), .data, .enable
    };
    stream_sink #(.W(W)) sink {
        .bus(link.slave), .observed
    };
}
